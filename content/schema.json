{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CyberPath CI · roadmap",
  "type": "object",
  "required": ["version", "tracks"],
  "properties": {
    "version": { "type": "string", "pattern": "^\\d{4}\\.\\d{1,2}\\.\\d+$" },
    "updated": { "type": "string", "format": "date" },
    "language": { "type": "string" },
    "tracks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "title", "levels", "steps"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "title": { "type": "string" },
          "levels": {
            "type": "array",
            "items": { "enum": ["BTS1", "BTS2", "L1", "L2", "L3", "AUTO"] }
          },
          "entry_points": {
            "type": "object",
            "additionalProperties": { "type": "string" }
          },
          "steps": {
            "type": "array",
            "minItems": 1,
            "items": { "$ref": "#/$defs/step" }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "link": {
      "type": "object",
      "required": ["title", "url", "lang", "free"],
      "properties": {
        "type": { "enum": ["cours", "video", "doc", "livre", "outil", "carte", "certification"] },
        "platform": { "type": "string" },
        "title": { "type": "string" },
        "url": { "type": "string", "pattern": "^https://" },
        "lang": { "enum": ["fr", "en"] },
        "free": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "step": {
      "type": "object",
      "required": ["id", "code", "title", "summary", "duration_weeks", "skills", "requires", "resources", "labs", "validation"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z]+-\\d{2}$" },
        "code": { "type": "string", "pattern": "^[A-Z]+-\\d{2}$" },
        "title": { "type": "string", "maxLength": 60 },
        "summary": { "type": "string", "maxLength": 200 },
        "duration_weeks": { "type": "integer", "minimum": 1, "maximum": 8 },
        "skills": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "requires": { "type": "array", "items": { "type": "string" } },
        "resources": { "type": "array", "items": { "$ref": "#/$defs/link" } },
        "labs": { "type": "array", "items": { "$ref": "#/$defs/link" } },
        "note": { "type": "string" },
        "validation": { "type": "string" },
        "unlocks": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    }
  }
}
