{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CyberPath CI · méthodologie",
  "type": "object",
  "required": ["version", "pentest"],
  "additionalProperties": false,
  "properties": {
    "version": { "type": "string", "pattern": "^\\d{4}\\.\\d{1,2}\\.\\d+$" },
    "pentest": {
      "type": "object",
      "required": ["title", "intro", "phases"],
      "additionalProperties": false,
      "properties": {
        "title": { "type": "string" },
        "intro": { "type": "string" },
        "automation": {
          "type": "object",
          "required": ["title", "text", "steps"],
          "additionalProperties": false,
          "properties": {
            "title": { "type": "string" },
            "text": { "type": "string" },
            "steps": { "type": "array", "items": { "type": "string" } }
          }
        },
        "phases": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["id", "name", "goal", "question", "steps"],
            "additionalProperties": false,
            "properties": {
              "id": { "type": "string" },
              "name": { "type": "string" },
              "goal": { "type": "string" },
              "question": { "type": "string" },
              "steps": { "type": "array", "minItems": 1, "items": { "type": "string" } }
            }
          }
        }
      }
    }
  }
}
