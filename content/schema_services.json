{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CyberPath CI · services découverts",
  "type": "object",
  "required": ["version", "intro", "services"],
  "additionalProperties": false,
  "properties": {
    "version": { "type": "string", "pattern": "^\\d{4}\\.\\d{1,2}\\.\\d+$" },
    "intro": { "type": "string" },
    "services": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "ports", "what_it_is", "check_first", "enum_tools", "cve_lookup", "legal_labs"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "name": { "type": "string" },
          "ports": { "type": "string" },
          "what_it_is": { "type": "string" },
          "check_first": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "enum_tools": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["tool_id", "why"],
              "additionalProperties": false,
              "properties": {
                "tool_id": { "type": "string" },
                "why": { "type": "string" }
              }
            }
          },
          "cve_lookup": { "type": "string" },
          "legal_labs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["platform", "title", "url"],
              "additionalProperties": false,
              "properties": {
                "platform": { "type": "string" },
                "title": { "type": "string" },
                "url": { "type": "string", "pattern": "^https://" }
              }
            }
          }
        }
      }
    }
  }
}
